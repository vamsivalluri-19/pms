NODE_ENV=development
PORT=5050
MONGO_URI=mongodb://localhost:27017/placetrack
JWT_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
FRONTEND_URL=http://localhost:3050
CORS_ORIGIN=http://localhost:3050,http://localhost:3051,http://localhost:5173

# Production example:
# FRONTEND_URL=https://your-frontend.vercel.app
# CORS_ORIGIN=https://your-frontend.vercel.app,https://*.vercel.app

# Optional services. Leave blank to keep the corresponding UI fallback active.
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
GEMINI_API_KEY=your_gemini_api_key
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_gmail_app_password

# Only needed when creating the first admin account via registration.
ADMIN_EMAIL=admin@example.edu
ADMIN_BOOTSTRAP_SECRET=replace_with_a_one_time_admin_setup_secret
